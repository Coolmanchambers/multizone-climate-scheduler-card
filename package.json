{
  "name": "multizone-climate-scheduler-card",
  "version": "0.7.0",
  "description": "Home Assistant dashboard card (Lovelace): multi-zone climate view for 1-4 zones with seasonal scheduling, fan timers, and runtime history.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild dist/multizone-climate-scheduler-card.js --minify-whitespace --allow-overwrite --outfile=dist/multizone-climate-scheduler-card.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "privacy": "node scripts/privacy-scan.mjs",
    "typecheck": "tsc --noEmit",
    "build:dev": "vite build --mode dev && esbuild dist/multizone-climate-scheduler-card-dev.js --minify-whitespace --allow-overwrite --outfile=dist/multizone-climate-scheduler-card-dev.js",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Coolmanchambers/multizone-climate-scheduler-card.git"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
